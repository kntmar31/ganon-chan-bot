# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here

# 任意：スラッシュコマンドの登録先
#   指定する: そのサーバーだけに登録します（すぐ反映されます。開発中は、テスト用サーバーのIDを指定するのがおすすめ）
#   空にする: Bot を入れたすべてのサーバーで使えるよう、全サーバー共通で登録します（本番向き。反映に時間がかかることがあります）
GUILD_ID=your-test-guild-id-here

# 任意：募集メッセージを常に特定のチャンネルに投稿したい場合はチャンネルIDを指定
# 未指定の場合は、コマンドを実行したチャンネルに投稿されます
RECRUIT_CHANNEL_ID=

# 任意：募集した人が付けると、募集メッセージをその絵文字だけに書き換える、サーバー独自の絵文字のID
# (標準の絵文字 💣 は、この設定にかかわらず使えます)
# 複数ある場合は、カンマで区切ります（例: 123456789012345678,987654321098765432）
# 絵文字のIDは、Discord のメッセージ入力欄に \:絵文字名: と入力して送信すると、<:絵文字名:ID> の形で表示されます
RECRUIT_END_EMOJI_ID=
